# Keyless dial needs no keys. Optional live BlockRun gateway only:
# BLOCKRUN_API_KEY=brk_live_...
# Get a card-funded key at https://user.blockrun.ai (vendor says 7 models free with no key).
#
# NEVER set BLOCKRUN_WALLET_KEY or SOLANA_WALLET_KEY in CI.
# The proxy may create a wallet under ~/.openclaw/blockrun — use a throwaway HOME.

DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
